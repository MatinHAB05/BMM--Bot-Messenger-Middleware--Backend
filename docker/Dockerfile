# syntax=docker/dockerfile:1

# ---- Build stage ----
FROM golang:1.22-alpine AS builder

RUN apk add --no-cache git ca-certificates

WORKDIR /src

# Cache module downloads separately from source changes. go.sum is copied
# as an optional glob (go.sum*) because it is generated by `go mod tidy` /
# `go mod download` -- see README "First-time setup" if it isn't present
# yet in your checkout.
COPY go.mod go.sum* ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/app ./cmd/app

# ---- Runtime stage ----
FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata && \
    addgroup -S app && adduser -S app -G app

WORKDIR /app

COPY --from=builder /out/app ./app
# Migrations and the Casbin model are read from disk at runtime (not
# embedded into the binary), so they travel with the image.
COPY --from=builder /src/migrations ./migrations
COPY --from=builder /src/config ./config

RUN mkdir -p logs clean-logs && chown -R app:app /app

USER app

EXPOSE 8080

ENTRYPOINT ["./app"]
