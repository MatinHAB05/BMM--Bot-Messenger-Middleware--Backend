# Copy this file to .env and fill in real values before running the app
# or docker-compose. Never commit the real .env.

# ---- Application ----
APP_ENV=
PORT=

# ---- PostgreSQL ----
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=

# ---- Redis ----
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=

# ---- PASETO ----
# 32-byte hex key -- generate with: openssl rand -hex 32
# (or: scripts/generate-paseto-key.sh)
PASETO_SYMMETRIC_KEY=
ACCESS_TOKEN_TTL=
REFRESH_TOKEN_TTL=
OTP_TOKEN_TTL=

# ---- Messenger engines ----
# Leave a token blank to disable that engine entirely; the backend still
# boots with just one platform configured (or neither, for local dev).
TELEGRAM_BOT_TOKEN=
BALE_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
BALE_BOT_USERNAME=

# -- Email
BMM_EMAIL=
BMM_EMAIL_APP_PASSWORD=
SMTP_HOST=
SMTP_HOST_PORT=
BMM_EMAIL_LOG_IN_FILE=
BMM_EMAIL_REAL_SEND=

# ---- Initial super-admin account (seeded idempotently on every boot) ----
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=
SUPERADMIN_EMAIL=
SUPERADMIN_PHONE=
SUPERADMIN_COMPANY_NAME=
SUPERADMIN_COMPANY_CODE=



# ---- Rate limiting (requests/minute, sliding window) ----
RATE_LIMIT_GLOBAL_PER_MINUTE=
RATE_LIMIT_AUTH_PER_MINUTE=
RATE_LIMIT_BROADCAST_PER_MINUTE=

#
LOG_DIR_FILE_PATH_CLEAN=
LOG_DIR_FILE_PATH=

LOG_ERR_DIR_FILE_PATH_CLEAN=
LOG_ERR_DIR_FILE_PATH=


DATABASE_MIGRATION_DIR_PATH=
CASBIN_CONF_FILE_PATH=
ADMIN_CHATS_FILE_PATH=


# S3 STORAGE
RUSTFS_API_HOST=
RUSTFS_API_PORT=
RUSTFS_CONSOLE_PORT=

RUSTFS_ENDPOINT=
RUSTFS_ACCESS_KEY_ID=
RUSTFS_SECRET_ACCESS_KEY=
RUSTFS_USE_SSL=
RUSTFS_REGION=
RUSTFS_BUCKET=
RUSTFS_MAX_CURRENCY=