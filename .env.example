# Copy this file to .env and fill in real values before running the app
# or docker-compose. Never commit the real .env.

# ---- Application ----
APP_ENV=
PORT=

# ---- PostgreSQL ----
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=

# ---- Redis ----
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=

# ---- PASETO ----
# 32-byte hex key -- generate with: openssl rand -hex 32
# (or: scripts/generate-paseto-key.sh)
PASETO_SYMMETRIC_KEY=
ACCESS_TOKEN_TTL=
REFRESH_TOKEN_TTL=
OTP_TOKEN_TTL=

# ---- Messenger engines ----
# Leave a token blank to disable that engine entirely; the backend still
# boots with just one platform configured (or neither, for local dev).
TELEGRAM_BOT_TOKEN=
BALE_BOT_TOKEN=

# ---- Email ----
BMM_EMAIL=
BMM_EMAIL_APP_PASSWORD=
SMTP_HOST=
SMTP_HOST_PORT=
BMM_EMAIL_LOG_IN_FILE=
BMM_EMAIL_REAL_SEND=

# ---- Initial admin account (seeded idempotently on every boot) ----
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_COMPANY_NAME=
ADMIN_COMPANY_CODE=
ADMIN_CHATS=

# ---- Rate limiting (requests/minute, sliding window) ----
RATE_LIMIT_GLOBAL_PER_MINUTE=
RATE_LIMIT_AUTH_PER_MINUTE=
RATE_LIMIT_BROADCAST_PER_MINUTE=

# ---- Logging ----
LOG_DIR_FILE_PATH_CLEAN=
LOG_DIR_FILE_PATH=
LOG_ERR_DIR_FILE_PATH_CLEAN=
LOG_ERR_DIR_FILE_PATH=

# ---- Paths & Configuration ----
DATABASE_MIGRATION_DIR_PATH=
CASBIN_CONF_FILE_PATH=